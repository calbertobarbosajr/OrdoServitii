# k8s/2-secrets.yaml.example
# ATENÇÃO: Este é um arquivo de modelo. 
# Copie este arquivo para 2-secrets.yaml e substitua os valores antes de aplicar.
# NUNCA faça commit do arquivo 2-secrets.yaml real com senhas verdadeiras.

apiVersion: v1
kind: Secret
metadata:
  name: ordoservitii-secrets
  namespace: ordoservitii
type: Opaque
stringData:
  POSTGRES_USER: "dev_user"
  POSTGRES_PASSWORD: "dev_password_123" # Substitua por uma senha forte localmente
  POSTGRES_DB: "ordoservitii_db"
  DATABASE_URL: "postgresql://dev_user:dev_password_123@postgres:5432/ordoservitii_db"
  REDIS_URL: "redis://redis:6379"
  RABBITMQ_URL: "amqp://guest:guest@rabbitmq:5672"
  RABBITMQ_DEFAULT_USER: "guest"
  RABBITMQ_DEFAULT_PASS: "guest"